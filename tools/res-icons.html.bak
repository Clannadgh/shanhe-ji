<!DOCTYPE html>
<html lang="zh-CN"><head><meta charset="utf-8">
<title>resource icons (cartoon, vector)</title>
<style>
  html, body { margin: 0; background: transparent; }
  #wrap { display: flex; gap: 8px; padding: 8px; }
  svg { width: 96px; height: 96px; display: block; }
</style></head>
<body>
<div id="wrap">

<!-- iron: 铁矿（未开发：灰岩里嵌着深色金属矿块 + 锈斑，不是铁锭） -->
<svg id="iron" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M47 51 L45 42 L52 38 L58 43 L57 51 Z" fill="#8d99a6"/>
    <path d="M13 51 L9 38 L17 26 L31 19 L45 24 L52 37 L49 51 Z" fill="#98a4b1"/>
    <path d="M17 26 L31 19 L45 24 L37 31 L22 32 Z" fill="#b3bec9"/>
    <!-- 和"金矿"同一套构图：一道贯穿岩体的矿脉 + 几块矿石，只是颜色是钢灰 -->
    <path d="M19 36 L27 41 L33 35 L40 41" fill="none" stroke="#495663" stroke-width="4.4"/>
  </g>
  <!-- 矿块：深色金属块（铁矿的辨识点，和"纯石头"分开） -->
  <g stroke="#2b3238" stroke-width="2.2" stroke-linejoin="round">
    <path d="M22 44 L31 42 L33 50 L24 52 Z" fill="#48545f"/>
    <path d="M38 29 L47 27 L49 36 L40 38 Z" fill="#54616e"/>
  </g>
  <g fill="#8a98a6">
    <path d="M25 45 L29 44 L30 48 L26 49 Z"/>
    <path d="M41 31 L44 30 L45 34 L42 35 Z"/>
  </g>
  <path d="M33 47 L38 45" stroke="#b06a3f" stroke-width="3.4" stroke-linecap="round"/>
</svg>

<!-- gold: 金矿（未开发：暖色岩里嵌金脉金粒，不是金锭/金条） -->
<svg id="gold" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M47 51 L45 42 L52 38 L58 43 L57 51 Z" fill="#b0a48d"/>
    <path d="M13 51 L9 38 L17 26 L31 19 L45 24 L52 37 L49 51 Z" fill="#bcb098"/>
    <path d="M17 26 L31 19 L45 24 L37 31 L22 32 Z" fill="#d3c8b0"/>
    <path d="M19 36 L27 41 L33 35 L40 41" fill="none" stroke="#d9a92e" stroke-width="4.4"/>
  </g>
  <g fill="#edbd45">
    <path d="M23 45 L30 43 L32 49 L25 51 Z"/>
    <path d="M39 30 L45 28 L47 35 L41 37 Z"/>
    <path d="M28 25 L32 24 L33 29 L29 30 Z"/>
  </g>
</svg>

<!-- grain: 耕地（未开发：可开垦的田块——透视田块 + 一垄垄青苗，不是麦穗也不是粮袋） -->
<svg id="grain" viewBox="0 0 64 64" fill="none">
  <!-- 田埂：土色外框 -->
  <path d="M15 18 L49 18 L61 57 L3 57 Z" fill="#b57a44"
        stroke="#2b3238" stroke-width="3" stroke-linejoin="round"/>
  <!-- 田面：青苗覆盖的地块（略窄一圈，露出田埂） -->
  <path d="M18 23 L46 23 L55 52 L9 52 Z" fill="#8aa657"
        stroke="#2b3238" stroke-width="2.4" stroke-linejoin="round"/>
  <!-- 田垄：越靠上越密，给"这是一片地"的透视 -->
  <g stroke="#5f7a35" stroke-width="2.2" stroke-linecap="round" opacity=".75">
    <path d="M21 29 L43 29"/>
    <path d="M19.5 35.5 L44.5 35.5"/>
    <path d="M17.5 42 L47 42"/>
    <path d="M15 48 L49 48"/>
  </g>
  <!-- 苗尖：只在放大时看得见，给"长着东西"的暗示 -->
  <g stroke="#a9c46a" stroke-width="2" stroke-linecap="round" opacity=".95">
    <path d="M26 29 L26 25.5 M32 29 L32 25 M38 29 L38 25.5"/>
    <path d="M22 42 L22 38.5 M28 42 L28 38 M34 42 L34 38.5 M40 42 L40 38"/>
  </g>
</svg>

<!-- horse: 畜牧（未开发：草地上吃草的牛 —— 牲畜的代表，不特指某一种动物） -->
<svg id="horse" viewBox="0 0 64 64" fill="none">
  <path d="M3 55 C13 51 23 57 33 54 C43 51 53 56 61 54 L61 60 L3 60 Z"
        fill="#8aa657" stroke="#2b3238" stroke-width="3" stroke-linejoin="round"/>
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <!-- 腿 -->
    <rect x="21" y="41" width="6" height="15" rx="2.6" fill="#efe9dd"/>
    <rect x="31" y="42" width="6" height="14" rx="2.6" fill="#ded6c7"/>
    <rect x="41" y="41" width="6" height="15" rx="2.6" fill="#efe9dd"/>
    <!-- 身体 -->
    <rect x="16" y="25" width="33" height="18" rx="9" fill="#f6f0e5"/>
    <!-- 头 -->
    <rect x="4" y="23" width="15" height="17" rx="5.5" fill="#f6f0e5"/>
    <!-- 耳 -->
    <path d="M19 26 L24 24 L23 30 Z" fill="#ddcdb8"/>
  </g>
  <!-- 角 -->
  <g stroke="#2b3238" stroke-width="2.6" stroke-linecap="round" fill="none">
    <path d="M10 23 C9 18 12 16 15 17"/>
    <path d="M16 23 C18 19 21 18 23 20"/>
  </g>
  <!-- 斑块 -->
  <path d="M26 26 C33 24 39 27 40 33 C35 37 27 36 24 31 Z" fill="#b08150"/>
  <!-- 口鼻 -->
  <ellipse cx="8" cy="34" rx="4.2" ry="3.6" fill="#e7b9a6"/>
  <!-- 眼 -->
  <circle cx="13" cy="29" r="1.7" fill="#2b3238"/>
  <!-- 尾 -->
  <path d="M49 28 C54 31 55 39 51 44" fill="none" stroke="#2b3238" stroke-width="3" stroke-linecap="round"/>
</svg>

<!-- timber: 林木（未开发：还长在地里的针叶林，不是原木/木板） -->
<svg id="timber" viewBox="0 0 64 64" fill="none">
  <!-- 后景小树：给"林子"的体量感，不抢主体 -->
  <g stroke="#2b3238" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round" opacity=".95">
    <path d="M14 50 L14 56" fill="none"/>
    <path d="M14 32 L20 44 L8 44 Z" fill="#7fa45c"/>
    <path d="M14 24 L21 38 L7 38 Z" fill="#7fa45c"/>
    <path d="M50 48 L50 56" fill="none"/>
    <path d="M50 34 L56 45 L44 45 Z" fill="#7fa45c"/>
    <path d="M50 27 L57 40 L43 40 Z" fill="#7fa45c"/>
  </g>
  <!-- 主体：三层树冠 + 树干，针叶树是"木材"最不会误读的形状 -->
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <rect x="29.5" y="46" width="7" height="12" rx="2.5" fill="#8a5a30"/>
    <path d="M32 6 L41 22 L23 22 Z" fill="#5f8b4c"/>
    <path d="M32 16 L45 36 L19 36 Z" fill="#6b9a55"/>
    <path d="M32 27 L50 50 L14 50 Z" fill="#79a85f"/>
  </g>
</svg>

<!-- fish: 渔获（活物，天然资源，原样保留） -->
<svg id="fish" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M12 33 C18 22 36 20 45 30 C47 33 47 35 45 38 C36 48 18 44 12 33 Z" fill="#9fc6cf"/>
    <path d="M45 34 L57 25 L57 43 Z" fill="#84b2bd"/>
    <path d="M30 22 L34 14 L40 22" fill="#84b2bd"/>
    <path d="M22 33 C26 30 32 30 36 33" fill="none" stroke-width="2" opacity=".45"/>
  </g>
  <circle cx="22" cy="31" r="1.9" fill="#2b3238"/>
</svg>

<!-- salt: 盐（未开发：天然盐晶簇/盐柱，不是盐砖、不是盐袋） -->
<svg id="salt" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M15 24 L21 18 L25 27 L23 51 L13 51 Z" fill="#eef3f6"/>
    <path d="M21 18 L25 27 L23 51 L18 51 L18 30 Z" fill="#dbe5ec"/>
    <path d="M47 28 L52 22 L56 30 L54 51 L45 51 Z" fill="#eef3f6"/>
    <path d="M52 22 L56 30 L54 51 L50 51 L50 32 Z" fill="#dbe5ec"/>
    <path d="M32 6 L42 17 L39 51 L25 51 L22 17 Z" fill="#ffffff"/>
    <path d="M32 6 L42 17 L39 51 L32 51 Z" fill="#e2ebf1"/>
  </g>
  <path d="M36.5 11.5 L36.5 16.5 M34 14 L39 14" stroke="#2b3238" stroke-width="2.2"
        stroke-linecap="round" opacity=".6"/>
</svg>

<!-- ============ 已开发形态（-dev）：同一套画法，画的是"开发之后变成什么" ============ -->

<!-- iron-dev: 铁锭（冶炼好的铁，三块梯形锭码成一堆） -->
<svg id="iron-dev" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M9 46 L26 46 L30 57 L5 57 Z" fill="#7c8895"/>
    <path d="M38 46 L55 46 L59 57 L34 57 Z" fill="#7c8895"/>
    <path d="M21 33 L38 33 L42 44 L17 44 Z" fill="#98a4b1"/>
  </g>
  <g stroke="#c9d3dc" stroke-width="2" stroke-linecap="round" opacity=".75">
    <path d="M15 50 L22 50"/><path d="M44 50 L51 50"/><path d="M27 37 L34 37"/>
  </g>
</svg>

<!-- gold-dev: 金锭（冶炼好的金，同样的码法） -->
<svg id="gold-dev" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M9 46 L26 46 L30 57 L5 57 Z" fill="#e2ac2e"/>
    <path d="M38 46 L55 46 L59 57 L34 57 Z" fill="#e2ac2e"/>
    <path d="M21 33 L38 33 L42 44 L17 44 Z" fill="#f2c85c"/>
  </g>
  <g stroke="#fbe6a8" stroke-width="2" stroke-linecap="round" opacity=".9">
    <path d="M15 50 L22 50"/><path d="M44 50 L51 50"/><path d="M27 37 L34 37"/>
  </g>
</svg>

<!-- grain-dev: 粮食（收进麻袋的谷子，袋口扎绳、露几粒） -->
<svg id="grain-dev" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M23 20 C23 16 27 14 32 14 C37 14 41 16 41 20 L42 23 L22 23 Z" fill="#b89c72"/>
    <path d="M18 30 C18 25 24 23 32 23 C40 23 46 25 46 30 L49 50 C49 56 43 58 32 58 C21 58 15 56 15 50 Z" fill="#d3bb95"/>
    <path d="M20 28 C26 25 38 25 44 28" fill="none" stroke-width="2.4"/>
  </g>
  <g fill="#e9c063">
    <path d="M27 11 L31 9 L33 13 L29 15 Z"/>
    <path d="M35 12 L38 10 L40 14 L37 16 Z"/>
  </g>
  <g stroke="#a98f66" stroke-width="1.8" stroke-linecap="round" opacity=".7">
    <path d="M24 38 L40 38"/><path d="M23 46 L41 46"/>
  </g>
</svg>

<!-- timber-dev: 木材（锯好码齐的板材，不再是立木） -->
<svg id="timber-dev" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M8 44 L56 44 L58 52 L6 52 Z" fill="#c9a273"/>
    <path d="M10 35 L54 35 L56 43 L8 43 Z" fill="#d9b483"/>
    <path d="M14 26 L50 26 L52 34 L12 34 Z" fill="#e3c496"/>
  </g>
  <g stroke="#a8825a" stroke-width="1.8" stroke-linecap="round" opacity=".75">
    <path d="M18 30 L34 30"/><path d="M14 39 L30 39"/><path d="M12 48 L28 48"/>
  </g>
</svg>

<!-- salt-dev: 盐（压成砖的盐，两块叠放） -->
<svg id="salt-dev" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M20 30 L50 30 L54 38 L16 38 Z" fill="#e7eef3"/>
    <path d="M14 40 L50 40 L54 54 L10 54 Z" fill="#f7fbfd"/>
    <path d="M14 40 L50 40 L50 46 L14 46 Z" fill="#e7eef3" stroke="none"/>
  </g>
  <g fill="#c6d4dd">
    <path d="M20 49 L22 49 L22 51 L20 51 Z"/>
    <path d="M30 49 L32 49 L32 51 L30 51 Z"/>
    <path d="M40 49 L42 49 L42 51 L40 51 Z"/>
    <path d="M26 33 L28 33 L28 35 L26 35 Z"/>
    <path d="M38 33 L40 33 L40 35 L38 35 Z"/>
  </g>
</svg>

<!-- fish-dev: 渔获（捞上来的两条鱼，不再是水里那一条） -->
<svg id="fish-dev" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round" opacity=".95">
    <path d="M14 27 C19 19 32 18 39 25 C41 27 41 29 39 31 C32 38 19 35 14 27 Z" fill="#b9d8de"/>
    <path d="M39 28 L49 21 L49 35 Z" fill="#9cc4cc"/>
  </g>
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M8 40 C15 30 32 29 41 38 C43 41 43 43 41 46 C32 55 15 51 8 40 Z" fill="#9fc6cf"/>
    <path d="M41 41 L53 32 L53 50 Z" fill="#84b2bd"/>
    <path d="M26 29 L30 21 L36 29" fill="#84b2bd"/>
    <path d="M18 40 C22 37 28 37 32 40" fill="none" stroke-width="2" opacity=".45"/>
  </g>
  <circle cx="18" cy="38" r="1.9" fill="#2b3238"/>
</svg>

<!-- horse-dev: 牲畜（同一头牛，套上项圈和铃铛 —— 已经驯养、有人管） -->
<svg id="horse-dev" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <rect x="21" y="41" width="6" height="15" rx="2.6" fill="#efe9dd"/>
    <rect x="31" y="42" width="6" height="14" rx="2.6" fill="#ded6c7"/>
    <rect x="41" y="41" width="6" height="15" rx="2.6" fill="#efe9dd"/>
    <rect x="16" y="25" width="33" height="18" rx="9" fill="#f6f0e5"/>
    <rect x="4" y="23" width="15" height="17" rx="5.5" fill="#f6f0e5"/>
    <path d="M19 26 L24 24 L23 30 Z" fill="#ddcdb8"/>
  </g>
  <g stroke="#2b3238" stroke-width="2.6" stroke-linecap="round" fill="none">
    <path d="M10 23 C9 18 12 16 15 17"/>
    <path d="M16 23 C18 19 21 18 23 20"/>
  </g>
  <path d="M26 26 C33 24 39 27 40 33 C35 37 27 36 24 31 Z" fill="#b08150"/>
  <ellipse cx="8" cy="34" rx="4.2" ry="3.6" fill="#e7b9a6"/>
  <circle cx="13" cy="29" r="1.7" fill="#2b3238"/>
  <path d="M49 28 C54 31 55 39 51 44" fill="none" stroke="#2b3238" stroke-width="3" stroke-linecap="round"/>
  <!-- 项圈 + 铃铛：驯养过的标志 -->
  <path d="M17 26 L22 26 L22 40 L17 40 Z" fill="#b5503f" stroke="#2b3238" stroke-width="2.6" stroke-linejoin="round"/>
  <circle cx="19.5" cy="42" r="3.4" fill="#e9c063" stroke="#2b3238" stroke-width="2.4"/>
</svg>

<!-- ============ 建筑形态（-bld）：开发这块地要盖的东西 ============ -->

<!-- iron-bld: 铁矿场（山体 + 木支架 + 矿洞） -->
<svg id="iron-bld" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M6 56 L6 42 L18 27 L46 27 L58 42 L58 56 Z" fill="#98a4b1"/>
    <path d="M23 56 L23 43 A9 9 0 0 1 41 43 L41 56 Z" fill="#333c45"/>
    <rect x="15" y="29" width="6" height="27" fill="#a9743f"/>
    <rect x="43" y="29" width="6" height="27" fill="#a9743f"/>
    <rect x="13" y="25" width="38" height="7" rx="1.5" fill="#c08a58"/>
  </g>
</svg>

<!-- gold-bld: 金矿场（同一套井口，岩石里带金粒） -->
<svg id="gold-bld" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M6 56 L6 42 L18 27 L46 27 L58 42 L58 56 Z" fill="#bcb098"/>
    <path d="M23 56 L23 43 A9 9 0 0 1 41 43 L41 56 Z" fill="#3a3630"/>
    <rect x="15" y="29" width="6" height="27" fill="#a9743f"/>
    <rect x="43" y="29" width="6" height="27" fill="#a9743f"/>
    <rect x="13" y="25" width="38" height="7" rx="1.5" fill="#c08a58"/>
  </g>
  <g fill="#edbd45">
    <path d="M10 45 L15 43 L17 48 L12 50 Z"/>
    <path d="M49 40 L54 38 L56 43 L51 45 Z"/>
    <path d="M44 51 L48 50 L49 54 L45 55 Z"/>
  </g>
</svg>

<!-- grain-bld: 农场（红顶谷仓） -->
<svg id="grain-bld" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M14 31 L50 31 L50 55 L14 55 Z" fill="#d09a6c"/>
    <path d="M9 31 L32 11 L55 31 Z" fill="#b5503f"/>
    <path d="M26 55 L26 41 L38 41 L38 55 Z" fill="#8a5a30"/>
  </g>
  <path d="M26 41 L38 55 M38 41 L26 55" stroke="#6b4522" stroke-width="2.2" stroke-linecap="round"/>
</svg>

<!-- horse-bld: 牧场（围栏 + 干草堆） -->
<svg id="horse-bld" viewBox="0 0 64 64" fill="none">
  <path d="M34 40 C34 30 42 24 50 24 C58 24 62 31 62 40 Z" fill="#e2c15f"
        stroke="#2b3238" stroke-width="3" stroke-linejoin="round"/>
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <rect x="5" y="28" width="5" height="26" fill="#a9743f"/>
    <rect x="28" y="28" width="5" height="26" fill="#a9743f"/>
    <rect x="51" y="30" width="5" height="24" fill="#a9743f"/>
    <rect x="3" y="34" width="56" height="6" rx="1.5" fill="#c08a58"/>
    <rect x="3" y="45" width="56" height="6" rx="1.5" fill="#c08a58"/>
  </g>
</svg>

<!-- timber-bld: 伐木场（木棚 + 两根原木） -->
<svg id="timber-bld" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M8 33 L25 17 L42 33 Z" fill="#8a5a30"/>
    <path d="M12 33 L38 33 L38 54 L12 54 Z" fill="#c08a58"/>
    <ellipse cx="46" cy="50" rx="9" ry="6" fill="#e6c795"/>
    <ellipse cx="46" cy="50" rx="3.2" ry="2.2" fill="none" stroke-width="2" opacity=".55"/>
    <ellipse cx="55" cy="41" rx="7" ry="5" fill="#e6c795"/>
    <ellipse cx="55" cy="41" rx="2.4" ry="1.7" fill="none" stroke-width="2" opacity=".55"/>
  </g>
</svg>

<!-- fish-bld: 渔港（栈桥 + 小船 + 水） -->
<svg id="fish-bld" viewBox="0 0 64 64" fill="none">
  <path d="M4 50 C12 46 20 54 28 50 C36 46 44 54 52 50 C56 48 59 50 61 51 L61 58 L4 58 Z"
        fill="#9fc6cf" stroke="#2b3238" stroke-width="3" stroke-linejoin="round"/>
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <rect x="5" y="38" width="30" height="6" rx="1.5" fill="#c9a273"/>
    <rect x="10" y="44" width="5" height="10" fill="#8a5a30"/>
    <rect x="26" y="44" width="5" height="10" fill="#8a5a30"/>
    <path d="M36 40 L61 40 L55 49 L42 49 Z" fill="#d9b483"/>
    <path d="M47 40 L47 20" fill="none" stroke-width="3"/>
    <path d="M47 21 L58 33 L47 33 Z" fill="#f6f2e8"/>
  </g>
</svg>

<!-- salt-bld: 盐场（盐田格子 + 盐堆） -->
<svg id="salt-bld" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M5 26 L27 26 L29 42 L3 42 Z" fill="#f4fafc"/>
    <path d="M33 26 L55 26 L57 42 L31 42 Z" fill="#eef6fa"/>
    <path d="M5 46 L28 46 L30 58 L3 58 Z" fill="#eef6fa"/>
    <path d="M34 46 L57 46 L59 58 L32 58 Z" fill="#f4fafc"/>
  </g>
  <path d="M10 33 L24 33 M38 33 L52 33 M11 52 L26 52 M39 52 L54 52"
        stroke="#a9c3d2" stroke-width="2.2" stroke-linecap="round"/>
  <g fill="#ffffff" stroke="#2b3238" stroke-width="2.4" stroke-linejoin="round">
    <path d="M44 20 L51 12 L58 20 Z"/>
  </g>
</svg>


<!-- freight-bld: 货运站（板车 + 两箱货） -->
<svg id="freight-bld" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <rect x="13" y="16" width="17" height="17" rx="1.5" fill="#d9b483"/>
    <rect x="33" y="23" width="14" height="10" rx="1.5" fill="#c9a273"/>
    <path d="M7 35 L57 35 L53 46 L11 46 Z" fill="#b57a44"/>
    <circle cx="19" cy="52" r="6.5" fill="#8a5a30"/>
    <circle cx="45" cy="52" r="6.5" fill="#8a5a30"/>
  </g>
  <g stroke="#a8825a" stroke-width="2" stroke-linecap="round">
    <path d="M13 21 L30 21 M17 16 L17 33"/>
    <path d="M37 27 L43 27"/>
  </g>
</svg>


<!-- ============ 建筑 Lv2（-bld-2）：升级后是**另一个东西**，不是同一栋楼加个框 ============ -->

<!-- iron-bld-2: 高炉（矿洞 → 高炉 + 出铁口） -->
<svg id="iron-bld-2" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M27 13 L41 13 L45 33 L50 52 L18 52 L23 33 Z" fill="#8b98a5"/>
    <rect x="28" y="3" width="10" height="10" fill="#6d7883"/>
    <path d="M27 43 L41 43 L41 51 L27 51 Z" fill="#e08a3c"/>
    <rect x="10" y="52" width="44" height="6" rx="1.5" fill="#7c8895"/>
  </g>
  <g stroke="#c9d3dc" stroke-width="2" stroke-linecap="round" opacity=".8">
    <path d="M30 26 L38 26"/><path d="M29 33 L39 33"/>
  </g>
</svg>

<!-- gold-bld-2: 井架 + 选矿厂（多了厂房和水轮） -->
<svg id="gold-bld-2" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M6 54 L16 16 L26 54" fill="none" stroke-width="4"/>
    <path d="M10 40 L22 40" fill="none" stroke-width="3"/>
    <path d="M13 28 L19 28" fill="none" stroke-width="3"/>
    <path d="M28 32 L54 32 L54 54 L28 54 Z" fill="#c08a58"/>
    <path d="M25 32 L41 18 L57 32 Z" fill="#8a5a30"/>
    <circle cx="44" cy="45" r="6" fill="#e9c063"/>
  </g>
  <circle cx="44" cy="45" r="2" fill="#2b3238"/>
</svg>

<!-- grain-bld-2: 谷仓 + 筒仓（多了座圆筒仓） -->
<svg id="grain-bld-2" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <rect x="34" y="17" width="19" height="37" fill="#e6dcc8"/>
    <path d="M34 17 C34 11 53 11 53 17 Z" fill="#b5503f"/>
    <path d="M6 31 L24 31 L24 54 L6 54 Z" fill="#d09a6c"/>
    <path d="M3 31 L15 19 L27 31 Z" fill="#b5503f"/>
    <path d="M24 25 L34 21" fill="none" stroke-width="2.6"/>
  </g>
  <path d="M39 26 L39 46 M46 26 L46 46" stroke="#c9bda6" stroke-width="2" stroke-linecap="round"/>
</svg>

<!-- horse-bld-2: 马厩（敞开式三开间，不再是围栏） -->
<svg id="horse-bld-2" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M6 27 L58 27 L58 54 L6 54 Z" fill="#c08a58"/>
    <path d="M3 27 L32 10 L61 27 Z" fill="#8a5a30"/>
    <path d="M12 54 L12 38 L22 38 L22 54 Z" fill="#6b4522"/>
    <path d="M27 54 L27 38 L37 38 L37 54 Z" fill="#6b4522"/>
    <path d="M42 54 L42 38 L52 38 L52 54 Z" fill="#6b4522"/>
  </g>
</svg>

<!-- timber-bld-2: 水锯（磨坊 + 大水轮） -->
<svg id="timber-bld-2" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M4 36 L26 36 L26 54 L4 54 Z" fill="#c08a58"/>
    <path d="M2 36 L15 20 L28 36 Z" fill="#8a5a30"/>
    <circle cx="45" cy="36" r="13" fill="#d9b483"/>
  </g>
  <g stroke="#a8825a" stroke-width="2" stroke-linecap="round">
    <path d="M45 23 L45 49 M32 36 L58 36 M36 27 L54 45 M54 27 L36 45"/>
  </g>
</svg>

<!-- fish-bld-2: 大渔港（双栈桥 + 双桅大船） -->
<svg id="fish-bld-2" viewBox="0 0 64 64" fill="none">
  <path d="M3 52 C10 48 18 56 26 52 C34 48 42 56 50 52 C55 50 58 52 61 53 L61 60 L3 60 Z"
        fill="#9fc6cf" stroke="#2b3238" stroke-width="3" stroke-linejoin="round"/>
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <rect x="3" y="42" width="26" height="5" fill="#c9a273"/>
    <rect x="35" y="42" width="26" height="5" fill="#c9a273"/>
    <rect x="7" y="47" width="4" height="8" fill="#8a5a30"/>
    <rect x="21" y="47" width="4" height="8" fill="#8a5a30"/>
    <rect x="39" y="47" width="4" height="8" fill="#8a5a30"/>
    <rect x="53" y="47" width="4" height="8" fill="#8a5a30"/>
    <path d="M19 30 L47 30 L41 42 L25 42 Z" fill="#d9b483"/>
    <path d="M33 30 L33 10 L45 21 L33 21 Z" fill="#f6f2e8"/>
    <path d="M31 30 L31 16 L21 24 L31 24 Z" fill="#eae4d4"/>
  </g>
</svg>

<!-- salt-bld-2: 盐田 + 风车（靠风车抽卤水） -->
<svg id="salt-bld-2" viewBox="0 0 64 64" fill="none">
  <g stroke="#2b3238" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    <path d="M4 40 L29 40 L31 55 L2 55 Z" fill="#f4fafc"/>
    <path d="M33 40 L57 40 L59 55 L31 55 Z" fill="#eef6fa"/>
